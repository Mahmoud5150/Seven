# Copy to .env and fill in. Never commit .env.

# --- server ---
DOMAIN=seven.example.com                 # your domain, pointed (DNS A record) at the VPS
PUBLIC_BASE_URL=https://seven.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-too                # opens https://<domain>/admin?key=<this> to add merchants

# --- WhatsApp (Meta Cloud API). Leave empty: messages go to outbox.jsonl instead ---
WHATSAPP_TOKEN=                          # a permanent System User token from Meta Business Manager
WHATSAPP_PHONE_NUMBER_ID=                # from WhatsApp Manager > API setup
WHATSAPP_API_VERSION=v25.0

# --- Email (any SMTP service). Leave empty: emails go to outbox.jsonl instead ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Seven <alerts@seven.example.com>

# --- Web Bot Auth: sign store requests (Shopify blocks unsigned bots). Create the key once:
#   docker compose run --rm worker python -m seven botkey --path /app/secrets/bot_key.pem
BOT_AUTH_KEY=/app/secrets/bot_key.pem

# --- optional: route store reads through a proxy (httpx reads these) ---
# HTTPS_PROXY=http://user:pass@proxy.example:8000
